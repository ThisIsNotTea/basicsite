---
import BaseLayout from "../../layouts/BaseLayout.astro";
import EventCard from "../../components/EventCard.astro";
import { getCollection } from "astro:content";
import { getUpcomingEvents } from "../../lib/events";

const events = getUpcomingEvents(await getCollection("events"));
---

<BaseLayout title="Events" description="Upcoming meetings and community events hosted by the county party.">
  <header class="page-intro">
    <div class="container">
      <p class="eyebrow">Get together, get involved</p>
      <h1>Events &amp; meetings</h1>
      <p>Join neighbors for local meetings, service opportunities, and community events.</p>
    </div>
  </header>
  <section class="section">
    <div class="container">
      {
        events.length ? (
          <div class="event-list">
            {events.map((event) => <EventCard event={event} />)}
          </div>
        ) : (
          <p>No upcoming events are listed at the moment. Follow our <a href="/news/">news</a> or <a href="/contact/">contact us</a> for updates.</p>
        )
      }
    </div>
  </section>
</BaseLayout>
